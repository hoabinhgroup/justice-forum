DirectoryIndex index.php

RewriteEngine On

# Keep the home page at the site root.
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[\s?]) [NC]
RewriteRule ^index\.php$ ./ [R=301,L]

# Redirect direct requests for PHP pages to their public .html URLs.
# THE_REQUEST prevents a redirect loop after the internal rewrite below.
RewriteCond %{THE_REQUEST} \s/+[^?\ ]+\.php(?:[?\ ]) [NC]
RewriteRule ^(programme|bilateral-meeting|layout|sightseeing)\.php$ $1.html [R=301,L,NE]

# Serve public .html URLs from the corresponding PHP files.
RewriteRule ^(programme|bilateral-meeting|layout|sightseeing)\.html$ $1.php [END]
